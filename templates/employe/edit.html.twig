{% extends 'base.html.twig' %}

{% block title %}Modifier Employé - Carlita Locks{% endblock %}
{% block page_title %}Modifier l'Employé{% endblock %}

{% block body %}
{% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show mb-3">
        {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
{% endfor %}

{% for message in app.flashes('danger') %}
    <div class="alert alert-danger alert-dismissible fade show mb-3">
        {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
{% endfor %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Modifier : {{ employe.prenom }} {{ employe.nom }}</h3>
            </div>
            <div class="card-body">
                <form method="post" action="{{ path('app_employe_edit', {id: employe.id}) }}">

                    {# NOM & PRENOM #}
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label required">Nom</label>
                            <input type="text" name="nom" class="form-control" value="{{ employe.nom }}" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label required">Prénom</label>
                            <input type="text" name="prenom" class="form-control" value="{{ employe.prenom }}" required>
                        </div>
                    </div>

                    {# EMAIL & TELEPHONE #}
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label required">Email</label>
                            <input type="email" name="email" class="form-control" value="{{ employe.email }}" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Téléphone</label>
                            <input type="text" name="telephone" class="form-control" value="{{ employe.telephone }}">
                        </div>
                    </div>

                    {# ROLE #}
                    <div class="mb-3">
                        <label class="form-label required">Rôle</label>
                        <select name="role" class="form-select" required>
                            <option value="gerant" {{ employe.role == 'gerant' ? 'selected' : '' }}>👑 Gérant</option>
                            <option value="coiffeur" {{ employe.role == 'coiffeur' ? 'selected' : '' }}>✂️ Coiffeur / Coiffeuse</option>
                            <option value="caissier" {{ employe.role == 'caissier' ? 'selected' : '' }}>💰 Caissier / Caissière</option>
                        </select>
                    </div>

                    {# STATUT #}
                    <div class="mb-3">
                        <label class="form-label">Statut</label>
                        <div>
                            <label class="form-check form-check-inline">
                                <input type="radio" name="actif" class="form-check-input" value="1" {{ employe.actif ? 'checked' : '' }}>
                                <span class="form-check-label">✅ Actif</span>
                            </label>
                            <label class="form-check form-check-inline">
                                <input type="radio" name="actif" class="form-check-input" value="0" {{ not employe.actif ? 'checked' : '' }}>
                                <span class="form-check-label">❌ Inactif</span>
                            </label>
                        </div>
                    </div>

                    {# MOT DE PASSE #}
                    <div class="mb-3">
                        <label class="form-label">Nouveau mot de passe</label>
                        <input type="password" name="mot_de_passe" class="form-control" placeholder="Laisser vide pour ne pas changer">
                        <div class="form-hint">Laissez vide si vous ne souhaitez pas modifier le mot de passe</div>
                    </div>

                    <div class="card-footer d-flex justify-content-between">
                        <a href="{{ path('app_employes') }}" class="btn btn-outline-secondary">
                            Annuler
                        </a>
                        <button type="submit" class="btn btn-primary">
                            Enregistrer les modifications
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}