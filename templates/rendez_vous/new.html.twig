{% extends 'base.html.twig' %}

{% block title %}Nouveau RDV - Carlita Locks{% endblock %}
{% block page_title %}Nouveau Rendez-vous{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Informations du rendez-vous</h3>
            </div>
            <div class="card-body">
                <form method="post" action="{{ path('app_rendez_vous_new') }}">

                    {# CLIENT #}
                    <div class="mb-3">
                        <label class="form-label required">Client</label>
                        <select name="client_id" class="form-select" required>
                            <option value="">-- Choisir un client --</option>
                            {% for client in clients %}
                                <option value="{{ client.id }}">
                                    {{ client.titre ? client.titre ~ ' ' : '' }}{{ client.prenom }} {{ client.nom }}
                                    {{ client.telephone ? '(' ~ client.telephone ~ ')' : '' }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    {# PRESTATION #}
                    <div class="mb-3">
                        <label class="form-label required">Prestation</label>
                        <select name="prestation_id" id="prestation_id" class="form-select" required>
                            <option value="">-- Choisir une prestation --</option>
                            {% for prestation in prestations %}
                                <option value="{{ prestation.id }}"
                                    data-duree="{{ prestation.dureeMinutes }}"
                                    data-prix="{{ prestation.prix }}">
                                    {{ prestation.categorie ? '[' ~ prestation.categorie ~ '] ' : '' }}{{ prestation.nom }}
                                    — {{ prestation.dureeMinutes }} min — {{ prestation.prix|number_format(0, ',', ' ') }} FCFA
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    {# EMPLOYE #}
                    <div class="mb-3">
                        <label class="form-label required">Employée</label>
                        <select name="employe_id" id="employe_id" class="form-select" required>
                            <option value="">-- Choisir d'abord une prestation --</option>
                        </select>
                    </div>

                    {# DATE & HEURE #}
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label required">Date et heure de début</label>
                            <input type="datetime-local" name="date_heure_debut" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Durée estimée</label>
                            <div id="duree_info" class="form-control bg-light text-muted">
                                Sélectionnez une prestation
                            </div>
                        </div>
                    </div>

                    {# NOTES #}
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea name="notes" class="form-control" rows="3" placeholder="Remarques, demandes spéciales..."></textarea>
                    </div>

                    <div class="card-footer d-flex justify-content-between">
                        <a href="{{ path('app_rendez_vous') }}" class="btn btn-outline-secondary">
                            Annuler
                        </a>
                        <button type="submit" class="btn btn-primary">
                            Enregistrer le RDV
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    // Quand on change la prestation, charger les employées autorisées
    document.getElementById('prestation_id').addEventListener('change', function() {
        const prestationId = this.value;
        const employeSelect = document.getElementById('employe_id');
        const dureeInfo = document.getElementById('duree_info');

        // Afficher la durée
        const option = this.options[this.selectedIndex];
        if (prestationId) {
            const duree = option.dataset.duree;
            const prix = option.dataset.prix;
            dureeInfo.textContent = duree + ' minutes — ' + parseInt(prix).toLocaleString() + ' FCFA';
            dureeInfo.classList.remove('text-muted');
            dureeInfo.classList.add('text-primary', 'fw-bold');
        } else {
            dureeInfo.textContent = 'Sélectionnez une prestation';
            dureeInfo.classList.add('text-muted');
            dureeInfo.classList.remove('text-primary', 'fw-bold');
        }

        // Charger les employées via AJAX
        if (prestationId) {
            fetch(`/rendez-vous/employes-par-prestation/${prestationId}`)
                .then(res => res.json())
                .then(employes => {
                    employeSelect.innerHTML = '<option value="">-- Choisir une employée --</option>';
                    if (employes.length === 0) {
                        employeSelect.innerHTML = '<option value="">Aucune employée assignée</option>';
                    } else {
                        employes.forEach(e => {
                            employeSelect.innerHTML += `<option value="${e.id}">${e.nom}</option>`;
                        });
                    }
                });
        } else {
            employeSelect.innerHTML = '<option value="">-- Choisir d\'abord une prestation --</option>';
        }
    });
</script>
{% endblock %}