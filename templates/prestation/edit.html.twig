{% extends 'base.html.twig' %}

{% block title %}Modifier Prestation - Carlita Locks{% endblock %}
{% block page_title %}Modifier la Prestation{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Modifier : {{ prestation.nom }}</h3>
            </div>
            <div class="card-body">
                <form method="post" action="{{ path('app_prestation_edit', {id: prestation.id}) }}">

                    {# CATEGORIE & NOM #}
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label required">Catégorie</label>
                            <select name="categorie" class="form-select" required>
                                <option value="">-- Choisir une catégorie --</option>
                                {% set categories = ['Tresses', 'Locks', 'Coiffure Femme', 'Coiffure Homme', 'Soins Capillaires', 'Coloration', 'Extensions / Perruques', 'Enfants', 'Barbe', 'Autre'] %}
                                {% for cat in categories %}
                                    <option value="{{ cat }}" {{ prestation.categorie == cat ? 'selected' : '' }}>{{ cat }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label required">Nom de la prestation</label>
                            <input type="text" name="nom" class="form-control" value="{{ prestation.nom }}" required>
                        </div>
                    </div>

                    {# DESCRIPTION #}
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="description" class="form-control" rows="3">{{ prestation.description }}</textarea>
                    </div>

                    {# DUREE & PRIX #}
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label required">Durée (en minutes)</label>
                            <div class="input-group">
                                <input type="number" name="duree_minutes" class="form-control" value="{{ prestation.dureeMinutes }}" min="5" step="5" required>
                                <span class="input-group-text">min</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label required">Prix</label>
                            <div class="input-group">
                                <input type="number" name="prix" class="form-control" value="{{ prestation.prix }}" min="0" step="100" required>
                                <span class="input-group-text">FCFA</span>
                            </div>
                        </div>
                    </div>

                    {# EMPLOYES #}
                    <div class="mb-3">
                        <label class="form-label required">Employées autorisées</label>
                        <div class="form-hint mb-2">Sélectionnez les employées qui peuvent réaliser cette prestation</div>
                        {% if employes is empty %}
                            <div class="alert alert-warning">
                                Aucune employée enregistrée.
                            </div>
                        {% else %}
                            <div class="row g-2">
                                {% for employe in employes %}
                                <div class="col-md-4">
                                    <label class="form-check">
                                        <input type="checkbox" name="employes[]" class="form-check-input"
                                            value="{{ employe.id }}"
                                            {{ prestation.employes.contains(employe) ? 'checked' : '' }}>
                                        <span class="form-check-label">
                                            {{ employe.prenom }} {{ employe.nom }}
                                            <span class="badge bg-blue-lt ms-1">{{ employe.role }}</span>
                                        </span>
                                    </label>
                                </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    {# COMMISSION #}
                    <div class="mb-3">
                        <label class="form-label">
                            Commission
                            <span class="text-muted">(optionnel)</span>
                        </label>
                        <div class="input-group" style="max-width: 200px;">
                            <input type="number" name="commission_pourcentage" class="form-control"
                                value="{{ prestation.commissionPourcentage }}"
                                placeholder="Ex: 20" min="0" max="100" step="0.5">
                            <span class="input-group-text">%</span>
                        </div>
                        <div class="form-hint">Laissez vide si aucune commission n'est appliquée</div>
                    </div>

                    {# STATUT #}
                    <div class="mb-3">
                        <label class="form-label">Statut</label>
                        <div>
                            <label class="form-check form-check-inline">
                                <input type="radio" name="actif" class="form-check-input" value="1" {{ prestation.actif ? 'checked' : '' }}>
                                <span class="form-check-label">✅ Active</span>
                            </label>
                            <label class="form-check form-check-inline">
                                <input type="radio" name="actif" class="form-check-input" value="0" {{ not prestation.actif ? 'checked' : '' }}>
                                <span class="form-check-label">❌ Inactive</span>
                            </label>
                        </div>
                    </div>

                    <div class="card-footer d-flex justify-content-between">
                        <a href="{{ path('app_prestations') }}" class="btn btn-outline-secondary">
                            Annuler
                        </a>
                        <button type="submit" class="btn btn-primary">
                            Enregistrer les modifications
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}