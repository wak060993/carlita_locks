<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
    <title>Connexion - Carlita Locks</title>
    <link rel="stylesheet" href="{{ asset('assets/css/tabler.min.css') }}">
</head>
<body class="antialiased">
<div class="page page-center">
    <div class="container container-tight py-4">

        {# LOGO #}
        <div class="text-center mb-4">
            <span style="font-size: 3rem;">✂️</span>
            <h2 class="mt-2 fw-bold">Carlita Locks</h2>
            <p class="text-muted">Connectez-vous à votre espace</p>
        </div>

        {# ERREUR #}
        {% if error %}
            <div class="alert alert-danger mb-3">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {# FORMULAIRE #}
        <div class="card card-md">
            <div class="card-body">
                <h2 class="card-title text-center mb-4">Connexion</h2>
                <form method="post" action="{{ path('app_login') }}">

                    <div class="mb-3">
                        <label class="form-label">Adresse email</label>
                        <input type="email" name="email" class="form-control" value="{{ last_username }}" placeholder="votre@email.com" autofocus required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mot de passe</label>
                        <input type="password" name="password" class="form-control" placeholder="Votre mot de passe" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-check">
                            <input type="checkbox" name="_remember_me" class="form-check-input">
                            <span class="form-check-label">Se souvenir de moi</span>
                        </label>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="form-footer">
                        <button type="submit" class="btn btn-primary w-100">
                            Se connecter
                        </button>
                    </div>

                </form>
            </div>
        </div>

        <div class="text-center text-muted mt-3">
            Carlita Locks &copy; {{ "now"|date("Y") }}
        </div>

    </div>
</div>
<script src="{{ asset('assets/js/tabler.min.js') }}"></script>
</body>
</html>