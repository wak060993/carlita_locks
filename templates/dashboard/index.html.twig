{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - Carlita Locks{% endblock %}
{% block page_title %}Tableau de bord{% endblock %}

{% block body %}

{# CARTES STATISTIQUES #}
<div class="row row-deck row-cards mb-3">

    <div class="col-sm-6 col-lg-3">
        <div class="card">
            <div class="card-body">
                <div class="subheader">RDV aujourd'hui</div>
                <div class="d-flex align-items-baseline">
                    <div class="h1 mb-0 me-2">{{ rdv_count }}</div>
                </div>
                <div class="mt-1">
                    <a href="{{ path('app_rendez_vous') }}" class="text-muted small">Voir les RDV →</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card">
            <div class="card-body">
                <div class="subheader">Clients</div>
                <div class="d-flex align-items-baseline">
                    <div class="h1 mb-0 me-2">{{ total_clients }}</div>
                    {% if nouveaux_clients > 0 %}
                        <span class="text-success small">+{{ nouveaux_clients }} ce mois</span>
                    {% endif %}
                </div>
                <div class="mt-1">
                    <a href="{{ path('app_clients') }}" class="text-muted small">Voir les clients →</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card">
            <div class="card-body">
                <div class="subheader">Recettes du jour</div>
                <div class="d-flex align-items-baseline">
                    <div class="h1 mb-0 me-2 text-success">
                        {{ rapport.total_entrees|number_format(0, ',', ' ') }} F
                    </div>
                </div>
                <div class="mt-1">
                    <a href="{{ path('app_caisse') }}" class="text-muted small">Voir la caisse →</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card {% if alertes_stock > 0 %}border-warning{% endif %}">
            <div class="card-body">
                <div class="subheader">Alertes stock</div>
                <div class="d-flex align-items-baseline">
                    <div class="h1 mb-0 me-2 {{ alertes_stock > 0 ? 'text-warning' : 'text-success' }}">
                        {{ alertes_stock }}
                    </div>
                </div>
                <div class="mt-1">
                    <a href="{{ path('app_stock') }}" class="text-muted small">Voir le stock →</a>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="row row-cards mb-3">

    {# GRAPHIQUE RECETTES 7 JOURS #}
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">📊 Recettes des 7 derniers jours</h3>
            </div>
            <div class="card-body">
                <canvas id="chartRecettes" height="120"></canvas>
            </div>
        </div>
    </div>

    {# MODE DE PAIEMENT #}
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">💳 Mode de paiement ce mois</h3>
            </div>
            <div class="card-body">
                {% if ca_par_mode_paiement is empty %}
                    <div class="text-center text-muted py-4">Aucune donnée</div>
                {% else %}
                    <canvas id="chartPaiement" height="180"></canvas>
                {% endif %}
            </div>
        </div>
    </div>

</div>

<div class="row row-cards mb-3">

    {# STATS RDV #}
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">📅 Stats RDV ce mois</h3>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span>Total RDV</span>
                    <strong>{{ stats_rdv.total }}</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-success">✅ Honorés</span>
                    <strong class="text-success">{{ stats_rdv.honores }}</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-danger">❌ Annulés</span>
                    <strong class="text-danger">
                        {{ stats_rdv.annules }}
                        <small>({{ stats_rdv.taux_annulation }}%)</small>
                    </strong>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-warning">👻 No-show</span>
                    <strong class="text-warning">
                        {{ stats_rdv.no_show }}
                        <small>({{ stats_rdv.taux_no_show }}%)</small>
                    </strong>
                </div>
                {% if stats_rdv.total > 0 %}
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar bg-success"
                        style="width: {{ stats_rdv.total > 0 ? (stats_rdv.honores / stats_rdv.total * 100)|round : 0 }}%">
                    </div>
                    <div class="progress-bar bg-danger"
                        style="width: {{ stats_rdv.taux_annulation }}%">
                    </div>
                    <div class="progress-bar bg-warning"
                        style="width: {{ stats_rdv.taux_no_show }}%">
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# HEURES DE POINTE #}
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">⏰ Heures de pointe</h3>
            </div>
            <div class="card-body p-0">
                {% if heures_pointe is empty %}
                    <div class="text-center text-muted py-4">Aucune donnée</div>
                {% else %}
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Heure</th>
                                <th>Nb RDV</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for h in heures_pointe %}
                            <tr>
                                <td>{{ h.heure }}h00</td>
                                <td>
                                    <span class="badge bg-blue-lt">{{ h.nb }} RDV</span>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>
    </div>

    {# TOP PRESTATIONS #}
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">🏆 Top prestations du mois</h3>
            </div>
            <div class="card-body p-0">
                {% if top_prestations is empty %}
                    <div class="text-center text-muted py-4">Aucune donnée ce mois</div>
                {% else %}
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Prestation</th>
                                <th>Nb</th>
                                <th>CA</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for p in top_prestations %}
                            <tr>
                                <td class="small">{{ p.nom }}</td>
                                <td><span class="badge bg-blue-lt">{{ p.nb }}x</span></td>
                                <td class="small fw-bold text-success">
                                    {{ (p.prix * p.nb)|number_format(0, ',', ' ') }} F
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>
    </div>

</div>

{# PROCHAINS RDV #}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">📅 RDV en cours aujourd'hui</h3>
        <div class="card-options">
            <a href="{{ path('app_rendez_vous_new') }}" class="btn btn-sm btn-primary">
                + Nouveau RDV
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        {% if prochain_rdv is empty %}
            <div class="text-center text-muted py-4">Aucun RDV en cours aujourd'hui</div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Heure</th>
                            <th>Client</th>
                            <th>Prestation</th>
                            <th>Employée</th>
                            <th>Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for rdv in prochain_rdv %}
                        <tr>
                            <td><strong>{{ rdv.dateHeureDebut|date('H:i') }}</strong></td>
                            <td>
                                {{ rdv.client.titre ? rdv.client.titre ~ ' ' : '' }}
                                {{ rdv.client.prenom }} {{ rdv.client.nom }}
                            </td>
                            <td>{{ rdv.prestation.nom }}</td>
                            <td>{{ rdv.employe.prenom }} {{ rdv.employe.nom }}</td>
                            <td>
                                {% if rdv.statut == 'en_attente' %}
                                    <span class="badge bg-yellow-lt">⏳ En attente</span>
                                {% elseif rdv.statut == 'confirme' %}
                                    <span class="badge bg-blue-lt">✅ Confirmé</span>
                                {% elseif rdv.statut == 'en_cours' %}
                                    <span class="badge bg-green-lt">🔄 En cours</span>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>

{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
// Graphique recettes 7 jours
const labelsRecettes = {{ recettes_7_jours|map(r => r.date)|json_encode|raw }};
const dataRecettes = {{ recettes_7_jours|map(r => r.total)|json_encode|raw }};

new Chart(document.getElementById('chartRecettes'), {
    type: 'bar',
    data: {
        labels: labelsRecettes,
        datasets: [{
            label: 'Recettes (FCFA)',
            data: dataRecettes,
            backgroundColor: 'rgba(32, 107, 196, 0.2)',
            borderColor: 'rgba(32, 107, 196, 1)',
            borderWidth: 2,
            borderRadius: 4,
        }]
    },
    options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
            y: {
                beginAtZero: true,
                ticks: {
                    callback: function(value) {
                        return value.toLocaleString('fr-FR') + ' F';
                    }
                }
            }
        }
    }
});

// Graphique mode de paiement
{% if ca_par_mode_paiement is not empty %}
const labelsPaiement = {{ ca_par_mode_paiement|map(p => p.modePaiement)|json_encode|raw }};
const dataPaiement = {{ ca_par_mode_paiement|map(p => p.total)|json_encode|raw }};

new Chart(document.getElementById('chartPaiement'), {
    type: 'doughnut',
    data: {
        labels: labelsPaiement,
        datasets: [{
            data: dataPaiement,
            backgroundColor: [
                'rgba(32, 107, 196, 0.8)',
                'rgba(47, 179, 68, 0.8)',
                'rgba(245, 159, 0, 0.8)',
            ],
            borderWidth: 2,
        }]
    },
    options: {
        responsive: true,
        plugins: {
            legend: {
                position: 'bottom',
                labels: { font: { size: 11 } }
            }
        }
    }
});
{% endif %}
</script>
{% endblock %}